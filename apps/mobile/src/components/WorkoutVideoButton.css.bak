.wvb-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border: 1px solid #ff5c00;
  border-radius: 999px;
  background: transparent;
  color: #ff5c00;
  font: inherit;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  white-space: nowrap;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.wvb-btn:hover {
  background: #ff5c00;
  color: #111;
}

.wvb-btn:focus-visible,
.wvb-close:focus-visible {
  outline: 2px solid #ff5c00;
  outline-offset: 2px;
}

.wvb-icon {
  width: 14px;
  height: 14px;
}

.wvb-overlay {
  position: fixed;
  inset: 0;
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(0, 0, 0, 0.8);
}

.wvb-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 560px;
  padding: 16px;
  border: 1px solid #2a2a2a;
  border-radius: 12px;
  background: #141414;
  color: #fff;
}

.wvb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.wvb-title {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 800;
  text-transform: uppercase;
}

.wvb-close {
  width: 32px;
  height: 32px;
  border: 1px solid #2a2a2a;
  border-radius: 8px;
  background: transparent;
  color: #fff;
  font-size: 1.4rem;
  line-height: 1;
  cursor: pointer;
}

.wvb-close:hover {
  border-color: #ff5c00;
  color: #ff5c00;
}

.wvb-video {
  display: block;
  width: 100%;
  max-height: 70vh;
  border-radius: 8px;
  background: #000;
}

.wvb-empty {
  margin: 24px 0;
  color: #9a9a9a;
  text-align: center;
}